# BuildGenie backend API base URL (includes /api/v1).\nNEXT_PUBLIC_API_BASE_URL=https://api.buildgenielabs.com/api/v1\n\n# Public Google Tag Manager web container ID.
NEXT_PUBLIC_GTM_ID=GTM-KK8BTHTC

# Public Google Analytics 4 measurement ID connected through the GTM container.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-17HBY8SV2K

# Optional only when using Google Search Console's HTML verification method.
