
/* Shared responsive navigation */
.mobile-nav { display: none; }
.mobile-menu { cursor: pointer; color: var(--ink); padding: 8px; }

/* Services overview */
.services-more { display: flex; justify-content: flex-end; margin-top: 26px; }
.services-hero { background: #f6f3ef; padding: 110px 0 64px; }
.services-hero-inner { max-width: 1180px; }
.services-hero h1 { margin: 27px 0 22px; font: 800 clamp(48px, 6vw, 76px)/1.06 var(--font-manrope), sans-serif; letter-spacing: -4px; }
.services-hero h1 span { color: var(--orange); }
.services-hero p { max-width: 620px; color: var(--muted); font-size: 15px; line-height: 1.9; }
.services-hero-meta { display: flex; align-items: center; gap: 16px; margin-top: 55px; color: #817a72; font-size: 9px; letter-spacing: 1.4px; font-weight: 750; }
.services-hero-meta i { width: 4px; height: 4px; border-radius: 50%; background: var(--orange); }
.capability-list { background: var(--paper); }
.capability-stack { border-top: 1px solid var(--line); }
.capability-row { display: grid; grid-template-columns: .85fr 1.15fr; gap: 80px; padding: 42px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 100px; }
.capability-heading { display: grid; grid-template-columns: 38px 48px 1fr; gap: 10px 15px; align-items: center; align-content: start; }
.capability-number { color: #a39c93; font-size: 10px; }
.capability-icon { width: 43px; height: 43px; display: grid; place-items: center; color: var(--orange); background: var(--orange-pale); border-radius: 50%; }
.capability-heading h3 { grid-column: 3; margin: 0; font: 750 22px var(--font-manrope); letter-spacing: -.7px; }
.capability-heading > p { grid-column: 2 / -1; margin: 7px 0 0; max-width: 340px; color: var(--muted); font-size: 12px; line-height: 1.8; }
.capability-offerings { display: grid; grid-template-columns: 1fr 1fr; gap: 25px 30px; }
.offering { display: flex; align-items: flex-start; gap: 11px; }
.offering-check { flex: 0 0 24px; height: 24px; display: grid; place-items: center; color: var(--orange); background: var(--orange-pale); border-radius: 50%; }
.offering h4 { margin: 2px 0 6px; font: 700 13px var(--font-manrope); }
.offering p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.75; }
.engagements { background: #f3f0ec; }
.engagement-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
.engagement-card { min-height: 265px; display: flex; flex-direction: column; padding: 22px 18px; background: white; border: 1px solid #e9e4dd; }
.engagement-top { display: flex; justify-content: space-between; align-items: center; color: var(--orange); }
.engagement-top span { font-size: 10px; color: #9a938a; }
.engagement-card h3 { margin: 32px 0 10px; font: 750 18px var(--font-manrope); }
.engagement-card p { color: var(--muted); font-size: 11px; line-height: 1.8; }
.engagement-card > a { display: flex; justify-content: space-between; gap: 7px; align-items: center; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line); font-size: 9px; font-weight: 700; }
.engagement-card > a svg { flex: 0 0 auto; color: var(--orange); }
.services-cta { background: var(--ink); color: white; }
.services-cta-inner { display: flex; justify-content: space-between; align-items: end; gap: 50px; }
.services-cta .eyebrow { color: #b2aaa2; }
.services-cta h2 { margin-bottom: 20px; }
.services-cta p { max-width: 510px; margin: 0; color: #b2ada7; font-size: 13px; line-height: 1.85; }
.services-cta .button { flex: 0 0 auto; }

@media (max-width: 1050px) {
  .capability-row { gap: 35px; }
  .engagement-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 720px) {
  .mobile-nav { display: block; position: fixed; inset: 70px 0 0; z-index: 30; padding: 22px 20px 40px; background: var(--paper); opacity: 0; visibility: hidden; transform: translateY(-8px); transition: opacity .2s, transform .2s, visibility .2s; }
  .mobile-nav.is-open { opacity: 1; visibility: visible; transform: translateY(0); }
  .mobile-nav nav { display: flex; flex-direction: column; }
  .mobile-nav nav > a:not(.button) { display: flex; align-items: center; justify-content: space-between; padding: 20px 3px; border-bottom: 1px solid var(--line); font: 700 22px var(--font-manrope); }
  .mobile-nav nav > a:not(.button) svg { color: var(--orange); }
  .mobile-nav .button { margin-top: 26px; }
  .services-hero { padding: 76px 0 45px; }
  .services-hero h1 { font-size: clamp(44px, 12vw, 60px); letter-spacing: -3px; }
  .services-hero p { font-size: 13px; }
  .services-hero-meta { flex-wrap: wrap; gap: 10px; font-size: 8px; }
  .capability-row { grid-template-columns: 1fr; gap: 28px; padding: 30px 0; }
  .capability-heading h3 { font-size: 19px; }
  .capability-offerings { grid-template-columns: 1fr; gap: 20px; padding-left: 2px; }
  .engagement-grid { grid-template-columns: 1fr; }
  .engagement-card { min-height: 210px; padding: 22px; }
  .engagement-card h3 { margin-top: 22px; }
  .services-cta-inner { display: block; }
  .services-cta .button { margin-top: 28px; }
}
